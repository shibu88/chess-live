# Build config for the single-tournament "World Chess Championship" site
# (https://fide-wcc-2026.netlify.app). Loaded only when building with
# `--mode wcc` (see `npm run build:wcc`). The default `npm run build` does NOT
# read this file, so it stays the full "Home" app (chess-live-626).
#
# These are public values (a display name + a public Lichess tournament id),
# not secrets — committed on purpose so the WCC build is reproducible.
VITE_SITE_NAME="World Chess Championship"
VITE_DEFAULT_TOUR="qfkdt8mn"
